#!/bin/sh
umask 077
. /usr/share/libubox/jshn.sh
STATUS_FILE="/tmp/portal-login.status"
LOG_FILE="/tmp/portal-login.log"
PID_FILE="/var/run/portal-login.pid"
PROG="/usr/bin/portal-login"
INIT_SCRIPT="/etc/init.d/portal-login"
st_get() { grep "^${1}=" "$STATUS_FILE" 2>/dev/null | head -1 | cut -d= -f2-; }
uint() { case "$1" in ''|*[!0-9]*|0[0-9]*) return 1 ;; esac; [ ${#1} -le 10 ]; }
range() { uint "$1" && [ "$1" -ge "$2" ] && [ "$1" -le "$3" ]; }
uci_get() { uci -q get "portal_login.main.$1" 2>/dev/null; }
reply() {
    json_init; json_add_string result "$1"; json_add_string msg "$2"; json_dump
}
is_running() {
    local pid
    pid=$(cat "$PID_FILE" 2>/dev/null)
    uint "$pid" && [ "$pid" -gt 1 ] && kill -0 "$pid" 2>/dev/null || return 1
    tr '\000' ' ' < "/proc/$pid/cmdline" 2>/dev/null | grep -q 'portal-login.*\(daemon\|start\)'
}
list_methods() {
    cat <<'EOF'
{"get_status":{},"get_logs":{"lines":0},"get_config":{},"set_config":{"user":"","pass":"","key":"","probe_url":"","check_interval":0,"retry_interval":0,"relogin_hour":0,"log_max":0,"debug":0,"enabled":0},"do_action":{"action":""}}
EOF
}
method_get_status() {
    local running=0 state ts count now elapsed uptime="" name key login_up up rest last_login
    state=$(st_get STATE)
    is_running && running=1
    [ "$running" = 1 ] || state=STOPPED
    ts=$(st_get LOGIN_TS); uint "$ts" || ts=0
    count=$(st_get FAIL_COUNT); range "$count" 0 1000000 || count=0
    now=$(date +%s)
    login_up=$(st_get LOGIN_UPTIME)
    read -r up rest < /proc/uptime
    up=${up%%.*}
    last_login=$(st_get LAST_LOGIN)
    if uint "$login_up" && [ "$login_up" -le "$up" ]; then
        elapsed=$((up-login_up))
        ts=$((now-elapsed))
        uptime=$(printf '%02d:%02d:%02d' "$((elapsed/3600))" "$((elapsed/60%60))" "$((elapsed%60))")
        # 用当前已校准的墙上时间反推，避免 NTP 校时前记录的时间一直偏移。
        last_login=$(date -d "@$ts" '+%Y-%m-%d %H:%M:%S' 2>/dev/null) || last_login=$(st_get LAST_LOGIN)
    elif [ "$ts" -gt 0 ] && [ "$ts" -le "$now" ]; then
        elapsed=$((now-ts))
        uptime=$(printf '%02d:%02d:%02d' "$((elapsed/3600))" "$((elapsed/60%60))" "$((elapsed%60))")
    fi
    json_init
    json_add_string state "$state"
    json_add_boolean running "$running"
    for name in p_host p_bras p_clientip p_vlan last_check error version transport probe_url; do
        key=$(printf '%s' "$name" | tr 'a-z' 'A-Z')
        json_add_string "$name" "$(st_get "$key")"
    done
    json_add_string last_login "$last_login"
    json_add_int login_ts "$ts"
    json_add_int fail_count "$count"
    json_add_string uptime "$uptime"
    json_dump
}
method_get_logs() {
    local input n raw=""
    input=$(cat)
    json_load "$input" 2>/dev/null || { reply error "请求不是有效 JSON"; return; }
    json_get_var n lines
    range "$n" 1 5000 || n=100
    [ ! -f "$LOG_FILE" ] || raw=$(tail -n "$n" "$LOG_FILE")
    json_init; json_add_string lines "$raw"; json_dump
}
method_get_config() {
    local has_pass=0 has_openclash=0 name
    [ -z "$(uci_get pass)" ] || has_pass=1
    [ ! -x /etc/init.d/openclash ] || has_openclash=1
    json_init
    json_add_boolean has_pass "$has_pass"
    json_add_boolean has_openclash "$has_openclash"
    for name in user key probe_url check_interval retry_interval relogin_hour log_max debug enabled; do
        json_add_string "$name" "$(uci_get "$name")"
    done
    json_dump
}
method_set_config() {
    local input name value type
    input=$(cat)
    json_load "$input" 2>/dev/null || { reply error "请求不是有效 JSON"; return; }
    # 所有字段验证后才写 UCI，空密码/密钥表示保留原值。
    for name in user pass key probe_url check_interval retry_interval relogin_hour log_max debug enabled; do
        json_get_type type "$name"
        [ -n "$type" ] || continue
        case "$type" in string|int) ;; *) reply error "字段类型无效: $name"; return ;; esac
        json_get_var value "$name"
        case "$value" in *[[:cntrl:]]*) reply error "字段不能包含控制字符: $name"; return ;; esac
        case "$name" in
            user) [ -n "$value" ] && [ ${#value} -le 128 ] ;;
            pass) [ ${#value} -le 512 ] ;;
            key) [ -z "$value" ] || { [ ${#value} -eq 16 ] && case "$value" in *[!A-Za-z0-9]*) false ;; *) true ;; esac; } ;;
            probe_url)
                case "$value" in http://?*) case "$value" in *[[:space:]]*|*\#*|*@*) false ;; *) true ;; esac ;; *) false ;; esac || {
                    reply error "探针须为不含账号的 HTTP 204 地址"; return;
                }
                ;;
            check_interval) range "$value" 5 600 ;;
            retry_interval) range "$value" 3 300 ;;
            relogin_hour) [ "$value" = -1 ] || range "$value" 0 23 ;;
            log_max) range "$value" 50 5000 ;;
            debug|enabled) [ "$value" = 0 ] || [ "$value" = 1 ] ;;
        esac || { reply error "配置值无效: $name"; return; }
    done
    # 私有暂存目录，避免中途失败留下半个请求及明文临时 JSON。
    local savedir failed=0
    savedir=$(mktemp -d /tmp/portal-login-uci.XXXXXX) || { reply error "无法建立配置事务"; return; }
    trap 'rm -rf "$savedir"' EXIT
    uci -q -t "$savedir" set portal_login.main=portal-login || failed=1
    for name in user pass key probe_url check_interval retry_interval relogin_hour log_max debug enabled; do
        json_get_type type "$name"
        [ -n "$type" ] || continue
        json_get_var value "$name"
        case "$name:$value" in pass:|key:) continue ;; esac
        uci -q -t "$savedir" set "portal_login.main.$name=$value" || failed=1
    done
    if [ "$failed" = 0 ] && uci -q -t "$savedir" commit portal_login; then
        chmod 600 /etc/config/portal_login
        json_get_var value enabled
        if [ -n "$value" ] && [ -x "$INIT_SCRIPT" ]; then
            if [ "$value" = 1 ]; then "$INIT_SCRIPT" enable; else "$INIT_SCRIPT" disable; fi || {
                rm -rf "$savedir"; trap - EXIT
                reply error "配置已保存，但开机自启设置失败，请检查日志"; return;
            }
        fi
        reply ok "配置已保存；重启守护进程后生效"
    else
        reply error "配置保存失败，未应用本次暂存"
    fi
    rm -rf "$savedir"
    trap - EXIT
}
method_do_action() {
    local input action rc=0 msg
    input=$(cat)
    json_load "$input" 2>/dev/null || { reply error "请求不是有效 JSON"; return; }
    json_get_var action action
    case "$action" in
        start|stop|restart)
            "$INIT_SCRIPT" "$action" >/dev/null 2>&1 || rc=$?
            msg="服务操作已提交" ;;
        login|relogin|probe)
            "$PROG" "$action" >/dev/null 2>&1 &
            msg="操作已提交，请查看状态和日志" ;;
        logs_clear) : > "$LOG_FILE"; msg="日志已清空" ;;
        *) reply error "未知操作"; return ;;
    esac
    [ "$rc" = 0 ] && reply ok "$msg" || reply error "服务操作失败"
}
case "$1" in
    list) list_methods ;;
    call)
        case "$2" in
            get_status) method_get_status ;;
            get_logs) method_get_logs ;;
            get_config) method_get_config ;;
            set_config) method_set_config ;;
            do_action) method_do_action ;;
            *) reply error "未知方法" ;;
        esac ;;
    *) reply error "调用方式无效" ;;
esac
