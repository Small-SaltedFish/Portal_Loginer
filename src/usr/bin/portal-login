#!/bin/sh
# portal-login — OpenWrt 校园网 Portal 自动认证守护程序
# 设备: Cudy TR3000 / KWrt
#
# 登录原理:
#   向普通 HTTP 地址发请求 → 被 AC 拦截 → 302 到 portal 登录页
#   Location URL 携带全部动态参数 (host/bras/clientip/mac/vlan)
#   解析参数 → AES-128-ECB 加密密码 → POST login → POST ack_auth
#
# 示例 302 Location:
#   http://192.168.199.200/index.html?bras=hn&wlanuserip=10.17.231.135
#   &clientip=10.17.231.135&wlanacname=hn&clientmac=d8:bb:c1:9e:7b:1b
#   &paip=172.16.100.200&vlan=1407.1051&iarmdst=140.143.144.103:8082/

readonly VERSION="1.4.0"
umask 077
readonly PROG="portal-login"

STATUS_FILE="/tmp/portal-login.status"
LOG_FILE="/tmp/portal-login.log"
PID_FILE="/var/run/portal-login.pid"
LOCK_FILE="/var/lock/portal-login.lock"
COOKIE_FILE="/tmp/portal-login.cookies"

# UCI 配置默认值
CFG_USER=""
CFG_PASS=""
CFG_KEY="5a3b9f207411a8ed"
CFG_PROBE_URL="http://connect.rom.miui.com/generate_204"
CFG_CHECK_INTERVAL=30
CFG_RETRY_INTERVAL=10
CFG_RELOGIN_HOUR=4        # 每天几点强制重新登录 (0-23，-1 禁用)
CFG_LOG_MAX=500
CFG_ENABLED=1
CFG_DEBUG=0
CFG_DIRECT_TOS=""        # 可选：与 OpenClash 原生 DSCP 绕过规则配套，168 对应 DSCP 42
PROBE_REASON=""

# 运行时 portal 参数（每次 probe 后更新）
P_HOST=""
P_BRAS=""
P_CLIENTIP=""
P_WLANUSERIP=""
P_WLANACNAME=""
P_CLIENTMAC=""
P_PAIP=""
P_VLAN=""
P_PORTAL_URL=""

_state="IDLE"
_login_ts=0
_fail_count=0
_last_relogin_day=0
_online_count=0          # 连续在线次数（用于日志汇总）
_probe_unknown_count=0  # 探测异常不等同于认证过期，保留现有会话
_daemon_started=0
_last_network_diagnostic=0

# =============================================================================
# 日志
# =============================================================================
_ts()    { date '+%Y-%m-%d %H:%M:%S'; }
_day()   { date '+%j'; }
_hour()  { date '+%H' | sed 's/^0//'; }
_up_seconds() {
    local up rest
    read -r up rest < /proc/uptime || return 1
    printf '%s\n' "${up%%.*}"
}

_log() {
    local lvl="$1"; shift
    local message
    message=$(printf '%s' "$*" | tr '\r\n' '  ')
    local line="[$lvl] $(_ts) [up=$(_up_seconds)s] $message"
    echo "$line" >> "$LOG_FILE"
    echo "$line" >&2   # 输出到 stderr，避免污染 $() 命令替换的 stdout 捕获
    local n; n=$(wc -l < "$LOG_FILE" 2>/dev/null || echo 0)
    if [ "$n" -gt "$CFG_LOG_MAX" ]; then
        local t; t=$(tail -n "$CFG_LOG_MAX" "$LOG_FILE"); echo "$t" > "$LOG_FILE"
    fi
}
log_i() { _log "INFO " "$@"; }
log_w() { _log "WARN " "$@"; }
log_e() { _log "ERROR" "$@"; }
log_d() { [ "$CFG_DEBUG" = "1" ] && _log "DEBUG" "$@"; return 0; }

# =============================================================================
# 状态文件（供 LuCI rpcd 读取）
# =============================================================================
st_set() {
    local k="$1" v="$2"
    # 按完整行写入，不让服务器返回的 &、反斜杠成为 sed 指令。
    v=$(printf '%s' "$v" | tr '\r\n' '  ')
    local tmp
    tmp=$(mktemp "${STATUS_FILE}.XXXXXX") || return 1
    PL_STATUS_KEY="$k" PL_STATUS_VALUE="$v" awk '
        BEGIN { k=ENVIRON["PL_STATUS_KEY"]; v=ENVIRON["PL_STATUS_VALUE"] }
        index($0,k "=")==1 { print k "=" v; found=1; next }
        { print }
        END { if (!found) print k "=" v }
    ' "$STATUS_FILE" > "$tmp" 2>/dev/null || {
        [ -f "$STATUS_FILE" ] && { rm -f "$tmp"; return 1; }
        printf '%s=%s\n' "$k" "$v" > "$tmp"
    }
    mv -f "$tmp" "$STATUS_FILE"
}
st_get() { grep "^${1}=" "$STATUS_FILE" 2>/dev/null | cut -d= -f2-; }

_set_state() {
    _state="$1"; st_set STATE "$_state"; st_set LAST_CHECK "$(_ts)"
}

# daemon 每轮和手动认证共用事务锁；休眠前释放，避免阻塞面板操作。
_acquire_lock() {
    command -v flock >/dev/null 2>&1 || { log_e "缺少 flock，无法安全执行认证"; return 1; }
    exec 9>"$LOCK_FILE"
    flock -n 9 && { _lock_held=1; return 0; }
    _lock_held=0
    exec 9>&-
    return 1
}
_release_lock() {
    # 关闭描述符释放内核锁；不删除锁文件，避免不同进程锁住不同 inode。
    exec 9>&-
    _lock_held=0
}

_daemon_cleanup() {
    [ "$_daemon_started" = 1 ] || return 0
    if [ "${_lock_held:-0}" = 1 ] || _acquire_lock; then
        st_set STATE STOPPED
        _release_lock
    fi
    [ "$(cat "$PID_FILE" 2>/dev/null)" = "$$" ] && rm -f "$PID_FILE"
}

_daemon_running() {
    local pid
    pid=$(cat "$PID_FILE" 2>/dev/null)
    _uint "$pid" && [ "$pid" -gt 1 ] && kill -0 "$pid" 2>/dev/null || return 1
    tr '\000' ' ' < "/proc/$pid/cmdline" 2>/dev/null | grep -q 'portal-login.*\(daemon\|start\)'
}

_init_status() {
    cat > "$STATUS_FILE" <<EOF
STATE=IDLE
LAST_LOGIN=
LAST_CHECK=
LOGIN_TS=0
FAIL_COUNT=0
P_HOST=
P_BRAS=
P_CLIENTIP=
P_VLAN=
ERROR=
PID=$$
VERSION=$VERSION
EOF
}

# =============================================================================
# UCI 配置
# =============================================================================
load_cfg() {
    command -v uci >/dev/null 2>&1 || { echo "load_cfg: uci 不可用" >&2; return; }
    local v
    v=$(uci -q get portal_login.main.enabled 2>/dev/null);        [ -n "$v" ] && CFG_ENABLED="$v"
    v=$(uci -q get portal_login.main.user 2>/dev/null);           [ -n "$v" ] && CFG_USER="$v"
    v=$(uci -q get portal_login.main.pass 2>/dev/null);           [ -n "$v" ] && CFG_PASS="$v"
    v=$(uci -q get portal_login.main.key 2>/dev/null);            [ -n "$v" ] && CFG_KEY="$v"
    v=$(uci -q get portal_login.main.probe_url 2>/dev/null);      [ -n "$v" ] && CFG_PROBE_URL="$v"
    v=$(uci -q get portal_login.main.check_interval 2>/dev/null); [ -n "$v" ] && CFG_CHECK_INTERVAL="$v"
    v=$(uci -q get portal_login.main.retry_interval 2>/dev/null); [ -n "$v" ] && CFG_RETRY_INTERVAL="$v"
    v=$(uci -q get portal_login.main.relogin_hour 2>/dev/null);   [ -n "$v" ] && CFG_RELOGIN_HOUR="$v"
    v=$(uci -q get portal_login.main.log_max 2>/dev/null);        [ -n "$v" ] && [ "$v" -ge 50 ] 2>/dev/null && CFG_LOG_MAX="$v"
    v=$(uci -q get portal_login.main.debug 2>/dev/null);          [ -n "$v" ] && CFG_DEBUG="$v"
    v=$(uci -q get portal_login.main.direct_tos 2>/dev/null);     [ -n "$v" ] && CFG_DIRECT_TOS="$v"
    # 配置加载诊断（始终输出到 stderr，不受 debug 开关控制）
    [ -z "$CFG_USER" ] && echo "load_cfg: 警告 - user 为空，检查 uci get portal_login.main.user" >&2
}

_uint() { case "$1" in ''|*[!0-9]*|0[0-9]*) return 1 ;; esac; [ ${#1} -le 10 ]; }
_range() { _uint "$1" && [ "$1" -ge "$2" ] && [ "$1" -le "$3" ]; }
validate_cfg() {
    _range "$CFG_CHECK_INTERVAL" 5 600 &&
    _range "$CFG_RETRY_INTERVAL" 3 300 &&
    _range "$CFG_LOG_MAX" 50 5000 &&
    { [ "$CFG_RELOGIN_HOUR" = -1 ] || _range "$CFG_RELOGIN_HOUR" 0 23; } &&
    { [ "$CFG_ENABLED" = 0 ] || [ "$CFG_ENABLED" = 1 ]; } &&
    { [ "$CFG_DEBUG" = 0 ] || [ "$CFG_DEBUG" = 1 ]; } || {
        echo "配置中的时间、日志行数或开关无效" >&2; return 1;
    }
    [ ${#CFG_KEY} -eq 16 ] || { echo "AES 密钥必须为 16 字节" >&2; return 1; }
    case "$CFG_KEY" in *[!A-Za-z0-9]*) echo "AES 密钥只支持 ASCII 字母数字" >&2; return 1 ;; esac
    case "$CFG_PROBE_URL" in http://?*) ;; *) echo "探针必须为 HTTP 地址" >&2; return 1 ;; esac
    case "$CFG_PROBE_URL" in *[[:space:]]*|*\#*) echo "探针地址包含无效字符" >&2; return 1 ;; esac
    [ -z "$CFG_DIRECT_TOS" ] || [ "$CFG_DIRECT_TOS" = 168 ] || { echo "直连流量标记应为 168 或留空" >&2; return 1; }
}

_has_openclash() { [ -x /etc/init.d/openclash ]; }
_openclash_rules_active() {
    nft list chain inet fw4 openclash_output >/dev/null 2>&1 ||
        nft list chain inet fw4 openclash_mangle_output >/dev/null 2>&1
}

_direct_curl() {
    # --noproxy 仅禁用显式代理。TOS 标记须与防火墙原生 RETURN 配套，不能单独承诺直连。
    if [ -n "$CFG_DIRECT_TOS" ] && _has_openclash; then
        curl -4 --noproxy '*' --ip-tos "$CFG_DIRECT_TOS" "$@"
    else
        curl -4 --noproxy '*' "$@"
    fi
}

_direct_channel_ready() {
    # 独立通道失效时宁可显示未确认，也不能借代理拿到 204 后误报校园网正常。
    _has_openclash || return 0
    if [ -z "$CFG_DIRECT_TOS" ]; then
        if [ "$(uci -q get openclash.config.router_self_proxy 2>/dev/null)" = 1 ]; then
            # 仅安装但已停止 OpenClash 时，不因残留开关阻止正常直连。
            if command -v nft >/dev/null 2>&1 && ! _openclash_rules_active; then return 0; fi
            return 1
        fi
        return 0
    fi
    [ "$CFG_DIRECT_TOS" = 168 ] || return 1
    command -v nft >/dev/null 2>&1 || return 1
    local chain rules
    for chain in openclash_output openclash_mangle_output; do
        rules=$(nft list chain inet fw4 "$chain" 2>/dev/null) || continue
        printf '%s\n' "$rules" | awk '
            /PortalLogin_Direct_42/ && /return/ && /skuid (0|root)/ && /dscp (0x2a|42)/ {found=1}
            END {exit !found}
        ' || return 1
    done
    return 0
}

_probe_url_direct_ready() {
    _has_openclash || return 0
    if command -v nft >/dev/null 2>&1 && ! _openclash_rules_active; then return 0; fi
    [ -n "$CFG_DIRECT_TOS" ] || return 0
    local host="${1#http://}"
    host=${host%%/*}; host=${host%%:*}
    if _valid_ipv4 "$host"; then
        case "$host" in 198.18.*|198.19.*) return 1 ;; *) return 0 ;; esac
    fi
    # 未注册的自定义域名可能得到 Fake-IP，不能把它当独立直连探针。
    grep -Fqx "$host" /etc/openclash/custom/openclash_custom_domain_dns.list 2>/dev/null
}

_json_field() { printf '%s' "$1" | jsonfilter -e "@.$2" 2>/dev/null; }

_valid_ipv4() {
    printf '%s\n' "$1" | awk -F. 'NF!=4 {exit 1} {for(i=1;i<=4;i++) if($i !~ /^[0-9]+$/ || $i>255) exit 1}'
}

_valid_params() {
    local address
    case "$P_HOST" in http://*) address=${P_HOST#http://} ;; https://*) address=${P_HOST#https://} ;; *) return 1 ;; esac
    local authority="$address" port
    address=${address%%:*}
    _valid_ipv4 "$address" || return 1
    # 本协议由校园内网 AC 提供；不向普通公网重定向发送凭据。
    case "$address" in
        10.*|192.168.*|172.16.*|172.17.*|172.18.*|172.19.*|172.2[0-9].*|172.30.*|172.31.*) ;;
        *) return 1 ;;
    esac
    case "$P_HOST" in *[!A-Za-z0-9.:/-]*) return 1 ;; esac
    case "$authority" in */*|*@*) return 1 ;; esac
    case "$authority" in *:*) port=${authority#*:}; _range "$port" 1 65535 || return 1 ;; esac
    [ -n "$P_BRAS" ] && _valid_ipv4 "$P_CLIENTIP" || return 1
    case "$P_BRAS$P_WLANUSERIP$P_WLANACNAME$P_CLIENTMAC$P_PAIP$P_VLAN" in
        *[!A-Za-z0-9._:%-]*) return 1 ;;
    esac
    # 冷启动或 DHCP 换址后，禁止用旧 clientip 对另一个会话反复认证。
    [ "$P_CLIENTIP" = "$(_get_wan_ip)" ]
}

_wan_route_ready() {
    # 地址存在不代表已拿到有效出口；冷启动时先等 netifd 安装路由。
    local address="$1" route
    _valid_ipv4 "$address" || return 1
    case "$address" in 0.*|127.*|169.254.*) return 1 ;; esac
    route=$(ip -4 route get 223.5.5.5 from "$address" 2>/dev/null) || return 1
    case "$route" in *unreachable*|*blackhole*|*prohibit*|'') return 1 ;; esac
    return 0
}

network_diagnostics() {
    local status
    status=$(ubus -S call network.interface.wan status 2>/dev/null)
    log_i "网络诊断: WAN up=$(_json_field "$status" up) pending=$(_json_field "$status" pending) device=$(_json_field "$status" l3_device) IPv4=$(_get_wan_ip)"
    log_i "网络诊断: DHCP server=$(printf '%s' "$status" | jsonfilter -e '@.data.dhcpserver' 2>/dev/null) lease=$(printf '%s' "$status" | jsonfilter -e '@.data.leasetime' 2>/dev/null)"
    log_i "网络诊断: 默认路由=$(ip -4 route show default 2>/dev/null | tr '\n' ';')"
    log_i "网络诊断: 本机 DNS=$(sed -n '/^nameserver /p' /etc/resolv.conf 2>/dev/null | tr '\n' ';')"
}

_network_diagnostics_throttled() {
    local now
    now=$(_up_seconds)
    if [ "$_last_network_diagnostic" = 0 ] || [ $((now-_last_network_diagnostic)) -ge 60 ]; then
        _last_network_diagnostic="$now"
        network_diagnostics
    fi
}

# =============================================================================
# Portal 参数持久化（UCI）— 解决重启后 fallback 参数丢失
# =============================================================================
_save_params_uci() {
    # 将当前 portal 参数持久化到 UCI，重启后仍可用于 fallback
    command -v uci >/dev/null 2>&1 || return
    [ -z "$P_HOST" ] && return
    if [ "$(uci -q get portal_login.main.last_host)" = "$P_HOST" ] &&
       [ "$(uci -q get portal_login.main.last_bras)" = "$P_BRAS" ] &&
       [ "$(uci -q get portal_login.main.last_clientip)" = "$P_CLIENTIP" ] &&
       [ "$(uci -q get portal_login.main.last_clientmac)" = "$P_CLIENTMAC" ] &&
       [ "$(uci -q get portal_login.main.last_paip)" = "$P_PAIP" ] &&
       [ "$(uci -q get portal_login.main.last_vlan)" = "$P_VLAN" ]; then return 0; fi
    uci -q set portal_login.main.last_host="$P_HOST"       2>/dev/null
    uci -q set portal_login.main.last_bras="$P_BRAS"       2>/dev/null
    uci -q set portal_login.main.last_clientip="$P_CLIENTIP" 2>/dev/null
    uci -q set portal_login.main.last_clientmac="$P_CLIENTMAC" 2>/dev/null
    uci -q set portal_login.main.last_paip="$P_PAIP"       2>/dev/null
    uci -q set portal_login.main.last_vlan="$P_VLAN"       2>/dev/null
    uci -q commit portal_login 2>/dev/null
    log_d "portal 参数已持久化到 UCI"
}

_restore_params_uci() {
    # daemon 启动时从 UCI 恢复上次保存的 portal 参数到 status 文件
    command -v uci >/dev/null 2>&1 || return
    local v
    v=$(uci -q get portal_login.main.last_host 2>/dev/null)
    [ -z "$v" ] && return 1
    st_set P_HOST "$v";      P_HOST="$v"
    v=$(uci -q get portal_login.main.last_bras 2>/dev/null)
    [ -n "$v" ] && { st_set P_BRAS "$v";      P_BRAS="$v"; }
    v=$(uci -q get portal_login.main.last_clientip 2>/dev/null)
    [ -n "$v" ] && { st_set P_CLIENTIP "$v";   P_CLIENTIP="$v"; }
    v=$(uci -q get portal_login.main.last_clientmac 2>/dev/null)
    [ -n "$v" ] && { st_set P_CLIENTMAC "$v";  P_CLIENTMAC="$v"; }
    v=$(uci -q get portal_login.main.last_paip 2>/dev/null)
    [ -n "$v" ] && { st_set P_PAIP "$v";       P_PAIP="$v"; }
    v=$(uci -q get portal_login.main.last_vlan 2>/dev/null)
    [ -n "$v" ] && { st_set P_VLAN "$v";       P_VLAN="$v"; }
    log_i "恢复缓存参数: host=$P_HOST bras=$P_BRAS ip=$P_CLIENTIP"
    return 0
}

# =============================================================================
# WAN 接口检测
# =============================================================================
# 获取 WAN IP（stdout 输出 IP，无 IP 则输出空）
_get_wan_ip() {
    local status wan_ip wan_dev
    # netifd 的运行时结果优先，不能把静态接口名或 LAN 地址当作 WAN。
    if command -v ubus >/dev/null 2>&1 && command -v jsonfilter >/dev/null 2>&1; then
        status=$(ubus -S call network.interface.wan status 2>/dev/null) || return 1
        [ "$(printf '%s' "$status" | jsonfilter -e '@.up' 2>/dev/null)" = "true" ] || return 1
        wan_ip=$(printf '%s' "$status" | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null)
        [ -n "$wan_ip" ] && { printf '%s\n' "$wan_ip"; return 0; }
        return 1
    fi
    if command -v uci >/dev/null 2>&1; then
        wan_dev=$(uci -q get network.wan.device 2>/dev/null)
        [ -z "$wan_dev" ] && wan_dev=$(uci -q get network.wan.ifname 2>/dev/null)
    fi
    # 旧系统仅回退到明确配置的 WAN，不猜测 eth1（可能其实是 LAN）。
    for dev in $wan_dev; do
        [ -z "$dev" ] && continue
        wan_ip=$(ip -4 addr show dev "$dev" 2>/dev/null \
            | grep -oE 'inet [0-9.]+' | head -1 | cut -d' ' -f2)
        [ -n "$wan_ip" ] && { echo "$wan_ip"; return 0; }
    done
    return 1
}

# 从 WAN 接口刷新 P_CLIENTIP / P_CLIENTMAC（DHCP 续租后 IP 可能变）
_refresh_wan_params() {
    local wan_dev wan_ip wan_mac
    local status
    if command -v ubus >/dev/null 2>&1 && command -v jsonfilter >/dev/null 2>&1; then
        status=$(ubus -S call network.interface.wan status 2>/dev/null) || return 1
        wan_dev=$(printf '%s' "$status" | jsonfilter -e '@.l3_device' 2>/dev/null)
        wan_ip=$(_get_wan_ip) || return 1
    fi
    if command -v uci >/dev/null 2>&1; then
        [ -n "$wan_dev" ] || wan_dev=$(uci -q get network.wan.device 2>/dev/null)
        [ -z "$wan_dev" ] && wan_dev=$(uci -q get network.wan.ifname 2>/dev/null)
    fi
    for dev in $wan_dev; do
        [ -z "$dev" ] && continue
        wan_ip=$(ip -4 addr show dev "$dev" 2>/dev/null \
            | grep -oE 'inet [0-9.]+' | head -1 | cut -d' ' -f2)
        if [ -n "$wan_ip" ]; then
            wan_dev="$dev"
            break
        fi
    done
    wan_mac=$(cat "/sys/class/net/$wan_dev/address" 2>/dev/null)
    if [ -n "$wan_ip" ]; then
        log_d "WAN 接口: dev=$wan_dev ip=$wan_ip mac=$wan_mac"
        P_CLIENTIP="$wan_ip"
        P_WLANUSERIP="$wan_ip"
        st_set P_CLIENTIP "$wan_ip"
        [ -n "$wan_mac" ] && { P_CLIENTMAC="$wan_mac"; st_set P_CLIENTMAC "$wan_mac"; }
    fi
}

# 从 status 文件恢复 portal 参数 + WAN 接口实时刷新
_restore_saved_params() {
    P_HOST=$(st_get P_HOST)
    P_BRAS=$(st_get P_BRAS)
    P_CLIENTIP=$(st_get P_CLIENTIP)
    P_WLANUSERIP=$(st_get P_CLIENTIP)
    P_CLIENTMAC=$(st_get P_CLIENTMAC)
    P_PAIP=$(st_get P_PAIP)
    P_VLAN=$(st_get P_VLAN)
    _refresh_wan_params  # 用 WAN 接口实时 IP/MAC 覆盖
}

# =============================================================================
# 核心：probe 探测
#   返回 0 = 需要登录（P_* 已填充）
#   返回 1 = 已在线
#   返回 2 = WAN 没有 IPv4 地址
#   返回 3 = 探测未确认；不登出、不使用缓存盲目重认证
# =============================================================================
probe_portal() {
    local result http_code redirect_url probe_url curl_rc wan_ip
    PROBE_REASON=""
    st_set PROBE_URL "$CFG_PROBE_URL"
    if [ -n "$CFG_DIRECT_TOS" ] && _has_openclash; then st_set TRANSPORT marked-direct;
    else st_set TRANSPORT system-direct; fi
    wan_ip=$(_get_wan_ip)
    [ -n "$wan_ip" ] || return 2
    _wan_route_ready "$wan_ip" || return 4
    _direct_channel_ready || {
        st_set TRANSPORT unavailable
        PROBE_REASON="独立直连规则未就绪，拒绝借代理探测校园网络"
        log_w "$PROBE_REASON"; return 3;
    }

    # 依次尝试国内 HTTP 探针，保留 AC 的 302 拦截能力。
    # 这些域名另在 OpenClash 第二 DNS 和直连例外中配置，避免依赖代理节点。
    for probe_url in "$CFG_PROBE_URL" \
        "http://connectivitycheck.platform.hicloud.com/generate_204" \
        "http://wifi.vivo.com.cn/generate_204"; do
        _probe_url_direct_ready "$probe_url" || { log_d "跳过未配置独立 DNS 的自定义探针"; continue; }
        result=$(_direct_curl -s \
            --connect-timeout 4 --max-time 6 --max-redirs 0 \
            -o /dev/null -w "%{http_code} %{redirect_url}" \
            "$probe_url" 2>/dev/null)
        curl_rc=$?
        http_code=$(echo "$result" | cut -d' ' -f1)
        redirect_url=$(echo "$result" | cut -d' ' -f2-)
        log_d "探测 $probe_url → $http_code"
        [ "$curl_rc" -eq 0 ] || continue
        case "$http_code" in
            204) return 1 ;;
            301|302|303|307|308)
                case "$redirect_url" in
                    *bras=*|*wlanuserip=*|*clientmac=*|*wlanacname=*)
                        log_i "探测 → 发现 portal 重定向"
                        _parse_portal_url "$redirect_url" && return 0
                        ;;
                esac
                ;;
        esac
    done
    # HTTP 错误、普通重定向和超时都不能证明认证过期。
    PROBE_REASON="国内直连探针未确认 (HTTP=${http_code:-未知}, curl=${curl_rc:-未知})，保留会话"
    return 3
}

_parse_portal_url() {
    local url="$1"
    P_PORTAL_URL="$url"
    P_HOST=$(echo "$url" | sed 's|\(https\?://[^/?]*\).*|\1|')
    _ep() { printf '%s' "$url" | grep -oE "[?&]${1}=[^&]+" | head -1 | cut -d= -f2; }
    P_BRAS=$(_ep bras)
    P_CLIENTIP=$(_ep clientip)
    P_WLANUSERIP=$(_ep wlanuserip)
    P_WLANACNAME=$(_ep wlanacname)
    P_CLIENTMAC=$(_ep clientmac)
    P_PAIP=$(_ep paip)
    P_VLAN=$(_ep vlan)
    [ -z "$P_BRAS" ] && [ -n "$P_WLANACNAME" ] && P_BRAS="$P_WLANACNAME"
    [ -n "$P_CLIENTIP" ] || P_CLIENTIP="$P_WLANUSERIP"
    _valid_params || { log_w "忽略无效、非内网或 clientip 与当前 WAN 不一致的认证跳转"; return 1; }
    log_i "Portal: host=$P_HOST bras=$P_BRAS ip=$P_CLIENTIP mac=$P_CLIENTMAC vlan=$P_VLAN"
    st_set P_HOST      "$P_HOST"
    st_set P_BRAS      "$P_BRAS"
    st_set P_CLIENTIP  "$P_CLIENTIP"
    st_set P_CLIENTMAC "$P_CLIENTMAC"
    st_set P_PAIP      "$P_PAIP"
    st_set P_VLAN      "$P_VLAN"
    _save_params_uci   # 持久化到 UCI，重启后可用于 fallback
    return 0
}

# =============================================================================
# 密钥自动检测
# =============================================================================
detect_key() {
    [ -z "$P_HOST" ] && return 1
    local content candidate path
    for path in "/assets/js/raas.js" "/js/raas.js" "/tp/default/js/index.js"; do
        content=$(_direct_curl -fsS --connect-timeout 5 --max-time 8 "${P_HOST}${path}" 2>/dev/null)
        [ -z "$content" ] && continue
        # 不能把 HTML 或脚本里碰巧出现的第一个 16 位字符串当作 AES 密钥。
        # 只接受门户显式传给 CryptoJS 的 UTF-8 文字密钥，识别不了就保留配置。
        candidate=$(printf '%s' "$content" | grep -oE "Utf8[.]parse[[:space:]]*\\([[:space:]]*['\"][A-Za-z0-9]{16}['\"]" \
            | head -1 | sed "s/.*['\"]\\([A-Za-z0-9]\\{16\\}\\)['\"]$/\\1/")
        [ -z "$candidate" ] && continue
        if [ "$candidate" != "$CFG_KEY" ]; then
            log_i "密钥变更: ${CFG_KEY:0:4}**** → ${candidate:0:4}****"
            CFG_KEY="$candidate"
            uci -q set portal_login.main.key="$candidate" 2>/dev/null
            uci -q commit portal_login 2>/dev/null
        fi
        return 0
    done
    return 1
}

# =============================================================================
# AES-128-ECB 密码加密（与 portal JS 完全一致）
# =============================================================================
encrypt_pass() {
    local plain="$1" key="$2"
    # 32 位纯字母数字直接返回（已加密 token）
    [ ${#plain} -eq 32 ] && case "$plain" in
        *[!A-Za-z0-9]*) ;;
        *) echo "$plain"; return 0 ;;
    esac

    local prefix
    prefix=$(cat /dev/urandom 2>/dev/null \
        | tr -dc 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/' \
        | head -c 4 2>/dev/null)
    [ ${#prefix} -ne 4 ] && prefix="xK9z"

    local pt="${prefix}${plain}"
    local pad=$(( (16 - (${#pt} % 16)) % 16 ))
    # key → hex（hexdump 或 od 均可）
    local keyhex
    if command -v hexdump >/dev/null 2>&1; then
        keyhex=$(printf '%s' "$key" | hexdump -v -e '/1 "%02x"')
    else
        keyhex=$(printf '%s' "$key" | od -A n -t x1 | tr -d ' \n')
    fi
    [ -z "$keyhex" ] && { log_e "encrypt: key 转 hex 失败"; return 1; }

    local tmp
    tmp=$(mktemp /tmp/portal-login-encrypt.XXXXXX) || return 1
    printf '%s' "$pt" > "$tmp"
    local i=0; while [ $i -lt $pad ]; do printf '\000' >> "$tmp"; i=$(( i+1 )); done

    # OpenSSL 3.x 兼容
    local ct errmsg
    errmsg=$(openssl enc -aes-128-ecb -nosalt -nopad \
             -K "$keyhex" -in "$tmp" -out "$tmp.ct" 2>&1); local rc=$?
    if [ $rc -ne 0 ]; then
        # 尝试 legacy provider (某些 OpenSSL 3.x 配置)
        errmsg=$(openssl enc -aes-128-ecb -nosalt -nopad \
                 -provider default -K "$keyhex" -in "$tmp" -out "$tmp.ct" 2>&1); rc=$?
    fi
    if [ $rc -ne 0 ] || [ ! -s "$tmp.ct" ]; then
        rm -f "$tmp" "$tmp.ct"
        log_e "encrypt: openssl 失败: $errmsg"
        return 1
    fi

    # 密文 → hex
    local cthex
    if command -v hexdump >/dev/null 2>&1; then
        cthex=$(hexdump -v -e '/1 "%02x"' "$tmp.ct")
    else
        cthex=$(od -A n -t x1 "$tmp.ct" | tr -d ' \n')
    fi
    rm -f "$tmp" "$tmp.ct"
    [ -z "$cthex" ] && { log_e "encrypt: 密文转 hex 失败"; return 1; }
    echo "$cthex"
}

# =============================================================================
# 登出（portal logoff API）
# =============================================================================
do_logout() {
    # 从状态文件补充 portal 参数（probe 在线时内存变量未填充）
    [ -z "$P_HOST" ]       && P_HOST=$(st_get P_HOST)
    [ -z "$P_BRAS" ]       && P_BRAS=$(st_get P_BRAS)
    [ -z "$P_CLIENTIP" ]   && P_CLIENTIP=$(st_get P_CLIENTIP)
    [ -z "$P_CLIENTMAC" ]  && P_CLIENTMAC=$(st_get P_CLIENTMAC)
    [ -z "$P_VLAN" ]       && P_VLAN=$(st_get P_VLAN)
    if [ -z "$P_HOST" ]; then
        log_d "登出: 无 portal host，跳过"
        rm -f "$COOKIE_FILE"; return 0
    fi
    _valid_params || { log_w "拒绝使用不匹配当前 WAN 的缓存参数登出"; return 1; }
    # logoff API：仅 URL 参数，无需 POST body，MAC 用连字符格式
    local mac_dash
    mac_dash=$(printf '%s' "$P_CLIENTMAC" | tr ':' '-')
    local logoff_url
    logoff_url="${P_HOST}/api/logoff.php?bras=${P_BRAS}&clientip=${P_CLIENTIP}"
    [ -n "$mac_dash" ] && logoff_url="${logoff_url}&clientmac=${mac_dash}"
    [ -n "$P_VLAN" ]   && logoff_url="${logoff_url}&vlan=${P_VLAN}"
    log_d "登出: $logoff_url"
    local resp
    resp=$(_direct_curl -fsS --connect-timeout 8 --max-time 15 -X POST "$logoff_url" 2>/dev/null) || {
        log_w "登出请求传输失败"; return 1;
    }
    local ret msg
    ret=$(_json_field "$resp" ret)
    msg=$(_json_field "$resp" msg)
    if [ "$ret" = "0" ]; then
        log_i "登出成功"
    else
        log_w "登出异常: ret=$ret $msg"
        return 1
    fi
    rm -f "$COOKIE_FILE"
    return 0
}

# =============================================================================
# 登录
# =============================================================================
_api_url() {
    local qs="bras=${P_BRAS}"
    [ -n "$P_CLIENTIP"   ] && qs="${qs}&clientip=${P_CLIENTIP}"
    [ -n "$P_WLANUSERIP" ] && qs="${qs}&wlanuserip=${P_WLANUSERIP}"
    [ -n "$P_WLANACNAME" ] && qs="${qs}&wlanacname=${P_WLANACNAME}"
    [ -n "$P_CLIENTMAC"  ] && qs="${qs}&clientmac=${P_CLIENTMAC}"
    [ -n "$P_PAIP"       ] && qs="${qs}&paip=${P_PAIP}"
    [ -n "$P_VLAN"       ] && qs="${qs}&vlan=${P_VLAN}"
    echo "${P_HOST}${1}?${qs}"
}

_curl_api() {
    # 确保 cookie 文件存在，否则 -b 在某些 curl 版本下会报错
    [ -f "$COOKIE_FILE" ] || touch "$COOKIE_FILE" 2>/dev/null
    _direct_curl -fsS --connect-timeout 8 --max-time 15 \
        -b "$COOKIE_FILE" -c "$COOKIE_FILE" \
        -H "User-Agent: Mozilla/5.0 (X11; Linux x86_64)" \
        -H "Referer: ${P_HOST}/index.html?bras=${P_BRAS}" \
        "$@"
}

_do_login() {
    [ -z "$CFG_USER" ] || [ -z "$CFG_PASS" ] && {
        log_e "登录失败: 账号或密码未配置"; st_set ERROR "账号密码未配置"; return 1; }
    _valid_params || { st_set ERROR "认证参数无效或 WAN 已换址，等待重新探测"; return 1; }

    log_i "登录中: $CFG_USER → $P_HOST"
    _set_state "LOGGING_IN"

    local enc
    enc=$(encrypt_pass "$CFG_PASS" "$CFG_KEY") || { _set_state "FAILED"; return 1; }

    # 建立 session cookie
    _curl_api -o /dev/null \
        "${P_HOST}/index.html?bras=${P_BRAS}&clientip=${P_CLIENTIP}&wlanuserip=${P_WLANUSERIP}&clientmac=${P_CLIENTMAC}" \
        2>/dev/null

    local resp transport_ok=1
    resp=$(_curl_api -X POST \
        -H "Content-Type: application/x-www-form-urlencoded; charset=UTF-8" \
        -H "Accept: application/json, */*" \
        --data-urlencode "user=${CFG_USER}" \
        --data-urlencode "pass=${enc}" \
        -d "authmode=0&pool=0&isp_id=0&pyacct=0" \
        "$(_api_url /api/login.php)" 2>/dev/null) || transport_ok=0
    [ "$transport_ok" = 1 ] || { st_set ERROR "登录接口传输失败，检查校园认证服务和 WAN"; return 1; }

    local ret
    ret=$(_json_field "$resp" ret)
    log_d "ret=$ret"
    case "$ret" in
        0|121|122|3)
            ;;
        '')
            local msg; msg=$(_json_field "$resp" msg)
            log_e "登录失败: 服务器返回异常 msg=$msg"
            st_set ERROR "ret=空 $msg"; return 1 ;;
        *)
            local msg; msg=$(_json_field "$resp" msg)
            log_e "登录失败: ret=$ret $msg"
            st_set ERROR "ret=$ret $msg"; return 1 ;;
    esac

    # 确认接口和实际联网证据分别检查，接口成功不等于已经联网。
    local ack ack_ret ack_ok=0
    ack=$(_curl_api -X POST \
        -H "Content-Type: application/x-www-form-urlencoded; charset=UTF-8" \
        --data-urlencode "user=${CFG_USER}" \
        --data-urlencode "pass=${enc}" \
        -d "authmode=0&pool=0&isp_id=0&pyacct=0" \
        "$(_api_url /api/ack_auth.php)" 2>/dev/null) && {
        ack_ret=$(_json_field "$ack" ret)
        [ "$ack_ret" = 0 ] && ack_ok=1
    }
    _set_state "VERIFYING"
    probe_portal
    local verified=$?
    if [ "$verified" -ne 1 ]; then
        if [ "$ack_ok" = 1 ]; then
            st_set ERROR "认证接口已确认，尚未验证联网，等待复查"
            log_w "认证已提交但联网未确认 (probe=$verified)"
            return 2
        fi
        st_set ERROR "确认接口失败且联网未确认"
        log_w "ack_auth 失败 (ret=${ack_ret:-未知}, probe=$verified)"
        return 1
    fi
    [ "$ack_ok" = 1 ] || log_w "确认接口响应异常，但国内探针已验证联网"

    _login_ts=$(date +%s)
    _fail_count=0
    _last_relogin_day=$(_day)
    st_set LAST_RELOGIN_DAY "$_last_relogin_day"
    st_set LAST_LOGIN "$(_ts)"; st_set LOGIN_TS "$_login_ts"
    st_set LOGIN_UPTIME "$(_up_seconds)"
    st_set FAIL_COUNT "0"; st_set ERROR ""
    _set_state "LOGGED_IN"
    log_i "登录成功"
    return 0
}

do_login() {
    _do_login
    local result=$?
    [ "$result" -ne 1 ] || _set_state FAILED
    return "$result"
}

# =============================================================================
# 主循环
# =============================================================================
_sleep() { _release_lock; local s="$1" i=0; while [ $i -lt $s ]; do sleep 1; i=$(( i+1 )); done; }

run_daemon() {
    exec 8>"${LOCK_FILE}.daemon"
    flock -n 8 || { log_e "另一个守护进程已运行"; return 75; }
    _acquire_lock || { log_e "认证事务正在执行，稍后由 procd 重试启动"; return 75; }
    _daemon_started=1
    log_i "启动 v$VERSION (PID $$) user=$CFG_USER check=${CFG_CHECK_INTERVAL}s relogin=${CFG_RELOGIN_HOUR}:00"
    echo "$$" > "$PID_FILE"
    local previous_ts previous_login previous_day previous_uptime
    previous_ts=$(st_get LOGIN_TS); previous_login=$(st_get LAST_LOGIN); previous_day=$(st_get LAST_RELOGIN_DAY)
    previous_uptime=$(st_get LOGIN_UPTIME)
    _init_status; _set_state "IDLE"
    if _uint "$previous_ts"; then st_set LOGIN_TS "$previous_ts"; st_set LAST_LOGIN "$previous_login"; fi
    if _uint "$previous_uptime"; then st_set LOGIN_UPTIME "$previous_uptime"; fi
    case "$previous_day" in [0-3][0-9][0-9]) _last_relogin_day="$previous_day"; st_set LAST_RELOGIN_DAY "$previous_day" ;; esac

    # 从 UCI 恢复上次保存的 portal 参数（重启后 /tmp 已清空）
    _restore_params_uci
    _release_lock
    local wan_signature="" wan_since=0 wan_now now

    while true; do
        _acquire_lock || { sleep 1; continue; }
        st_set LAST_CHECK "$(_ts)"
        # 双设备同时上电：WAN 地址/默认路由稳定后再认证，避免盲目固定开机延时。
        wan_now=$(_get_wan_ip); now=$(_up_seconds)
        if [ "$wan_now" != "$wan_signature" ]; then
            wan_signature="$wan_now"; wan_since="$now"
            log_i "WAN 地址变化，清空旧会话 cookie 并等待地址稳定"
            rm -f "$COOKIE_FILE"
            if [ "$(st_get P_CLIENTIP)" != "$wan_now" ]; then
                # 不把旧 bras/VLAN 机械配到新地址；等待 AC 给出当前会话参数。
                P_HOST=""; P_BRAS=""; P_VLAN=""; P_PAIP=""; P_CLIENTMAC=""
                P_CLIENTIP="$wan_now"; P_WLANUSERIP="$wan_now"
                local stale_key
                for stale_key in P_HOST P_BRAS P_VLAN P_PAIP P_CLIENTMAC; do st_set "$stale_key" ""; done
                st_set P_CLIENTIP "$wan_now"
            fi
        fi
        if [ -n "$wan_now" ] && ! _wan_route_ready "$wan_now"; then wan_since="$now"; fi
        if [ -n "$wan_now" ] && [ $((now-wan_since)) -lt 10 ]; then
            _set_state WAIT_NETWORK
            st_set ERROR "等待 WAN 地址和出口路由稳定；暂不认证"
            _network_diagnostics_throttled
            _sleep 3
            continue
        fi
        _state=$(st_get STATE)
        probe_portal
        local pr=$?

        # 每日定时强制重新登录
        if [ "$CFG_RELOGIN_HOUR" -ge 0 ] 2>/dev/null; then
            local cur_hour cur_day
            cur_hour=$(_hour); cur_day=$(_day)
            if [ "$cur_hour" = "$CFG_RELOGIN_HOUR" ] && [ "$cur_day" != "$_last_relogin_day" ] && [ "$pr" -eq 1 ]; then
                log_i "定时重登录 (${CFG_RELOGIN_HOUR}:00)"
                _last_relogin_day="$cur_day"
                st_set LAST_RELOGIN_DAY "$cur_day"
                if do_logout; then
                    sleep 2
                    probe_portal; pr=$?
                fi
            fi
        fi

        if [ $pr -eq 0 ] || [ $pr -eq 1 ]; then _probe_unknown_count=0; fi

        if [ $pr -eq 0 ]; then
            # 需要登录
            _online_count=0
            detect_key
            do_login
            local login_result=$?
            if [ "$login_result" -eq 0 ]; then
                _sleep "$CFG_CHECK_INTERVAL"
            elif [ "$login_result" -eq 2 ]; then
                _sleep "$CFG_RETRY_INTERVAL"
            else
                _fail_count=$(( _fail_count + 1 ))
                st_set FAIL_COUNT "$_fail_count"
                _set_state "FAILED"
                local backoff="$CFG_RETRY_INTERVAL" attempts=1
                while [ "$attempts" -lt "$_fail_count" ] && [ "$backoff" -lt 300 ]; do
                    backoff=$((backoff*2)); attempts=$((attempts+1))
                done
                [ "$backoff" -gt 300 ] && backoff=300
                log_w "登录失败 (${_fail_count}次), ${backoff}s 后重试"
                [ "$_fail_count" -eq 3 ] && network_diagnostics
                _sleep "$backoff"
            fi
        elif [ $pr -eq 1 ]; then
            # 在线
            st_set ERROR ""
            _fail_count=0; st_set FAIL_COUNT 0
            _online_count=$(( _online_count + 1 ))
            if [ "$_state" != "LOGGED_IN" ]; then
                log_i "探测 → 在线"
                _set_state "LOGGED_IN"
                _online_count=1
                if [ -z "$(st_get P_HOST)" ]; then
                    log_d "无 portal 参数缓存，从 WAN 接口补充"
                    _refresh_wan_params
                fi
            elif [ $(( _online_count % 10 )) -eq 0 ]; then
                # 每 10 次探测汇总一行（约 5 分钟）
                local mins=$(( _online_count * CFG_CHECK_INTERVAL / 60 ))
                log_i "在线 ×${_online_count} (${mins}m)"
            else
                log_d "在线 ×${_online_count}"
            fi
            _sleep "$CFG_CHECK_INTERVAL"
        elif [ $pr -eq 3 ]; then
            # 保留校园会话，但界面不能继续把旧的在线状态当作当前证据。
            _probe_unknown_count=$(( _probe_unknown_count + 1 ))
            _set_state "PROBE_UNKNOWN"
            st_set ERROR "${PROBE_REASON:-探测未确认，保留会话，不主动重新认证}"
            if [ $_probe_unknown_count -eq 1 ] || [ $(( _probe_unknown_count % 10 )) -eq 0 ]; then
                log_w "探测未确认 (${_probe_unknown_count}次)，保留会话，${CFG_CHECK_INTERVAL}s 后复查"
                network_diagnostics
            fi
            _sleep "$CFG_CHECK_INTERVAL"
        elif [ "$pr" -eq 4 ]; then
            _set_state WAIT_NETWORK
            st_set ERROR "WAN 已有地址但出口路由尚未就绪"
            _network_diagnostics_throttled
            _sleep "$CFG_RETRY_INTERVAL"
        else
            # WAN 确实没有 IPv4 地址
            _online_count=0
            if [ "$_state" != "OFFLINE" ]; then
                log_w "探测 → WAN 无 IP，等待网络"
                _set_state "OFFLINE"
                st_set ERROR "WAN 尚未获得 IPv4 地址，等待 DHCP/上级设备"
            else
                log_d "仍然离线，${CFG_RETRY_INTERVAL}s 后重试"
            fi
            _network_diagnostics_throttled
            _sleep "$CFG_RETRY_INTERVAL"
        fi
    done
}

# =============================================================================
# CLI 接口
# =============================================================================
usage() {
    cat <<EOF
$PROG v$VERSION

命令:
  daemon          守护进程模式
  start           前台运行（调试）
  login           单次登录
  relogin         强制重新登录（用于每日定时）
  probe           探测 portal 参数
  status          显示状态
  logs [N]        显示最近 N 条日志
  logs-clear      清空日志
  test-encrypt    测试加密
  stop            停止守护进程

选项: --user --pass --key --probe --debug
EOF
}

main() {
    local cmd="${1:-help}"; shift 2>/dev/null || true
    case "$cmd" in daemon|start|login|relogin|probe|test-encrypt) load_cfg ;; esac
    while [ $# -gt 0 ] && [ "$cmd" != "logs" ]; do
        case "$1" in
            --user|--pass|--key|--probe)
                [ $# -ge 2 ] || { echo "缺少选项参数" >&2; return 64; }
                case "$1" in
                    --user) CFG_USER="$2" ;;
                    --pass) CFG_PASS="$2" ;;
                    --key) CFG_KEY="$2" ;;
                    --probe) CFG_PROBE_URL="$2" ;;
                esac
                shift 2 ;;
            --debug) CFG_DEBUG=1;        shift ;;
            *) echo "未知选项: $1" >&2; return 64 ;;
        esac
    done
    case "$cmd" in daemon|start|login|relogin|probe|test-encrypt)
        validate_cfg || return 64
        local dependency
        for dependency in curl jsonfilter flock openssl; do
            command -v "$dependency" >/dev/null 2>&1 || { echo "缺少依赖: $dependency" >&2; return 69; }
        done
    ;; esac

    case "$cmd" in
        daemon)
            # procd 负责后台化、排他和 respawn
            [ "$CFG_ENABLED" = "0" ] && exit 0
            trap '_daemon_cleanup' EXIT
            trap 'exit 0' INT TERM
            run_daemon
            ;;
        start)
            # 手动前台调试模式
            [ "$CFG_ENABLED" = "0" ] && { echo "插件已禁用"; exit 0; }
            trap '_daemon_cleanup' EXIT
            trap 'exit 0' INT TERM
            run_daemon
            ;;
        login)
            _acquire_lock || { echo "认证操作正在进行" >&2; return 75; }
            trap '_release_lock' EXIT
            probe_portal
            local result=$?
            case "$result" in
                0) do_login ;;
                1) _set_state LOGGED_IN; st_set ERROR ""; echo "已在线，无需重复登录" ;;
                *) echo "无法确认认证状态，保留会话" >&2; return 2 ;;
            esac
            ;;
        relogin)
            _acquire_lock || { echo "认证操作正在进行" >&2; return 75; }
            trap '_release_lock' EXIT
            log_i "强制重登录"
            probe_portal
            local r=$?
            if [ $r -eq 2 ] || [ $r -eq 3 ] || [ $r -eq 4 ]; then
                log_w "无法确认网络状态，取消主动登出"
                return 2
            else
                [ "$r" -eq 0 ] && { do_login; return $?; }
                do_logout || return 1
                sleep 2
                probe_portal; r=$?
                if [ $r -eq 0 ]; then
                    do_login
                elif [ $r -eq 1 ]; then
                    log_i "登出后 AC 未立即断网，用缓存参数重认证"
                    P_HOST=$(st_get P_HOST)
                    P_BRAS=$(st_get P_BRAS)
                    P_CLIENTIP=$(st_get P_CLIENTIP)
                    P_WLANUSERIP=$(st_get P_CLIENTIP)
                    P_CLIENTMAC=$(st_get P_CLIENTMAC)
                    P_PAIP=$(st_get P_PAIP)
                    P_VLAN=$(st_get P_VLAN)
                    if [ -n "$P_HOST" ] && [ -n "$P_BRAS" ]; then
                        do_login
                    else
                        log_w "重登录失败: 无缓存 portal 参数"
                        return 1
                    fi
                else
                    log_w "重登录失败: 登出后网络不通"
                    return 2
                fi
            fi
            ;;
        probe)
            _acquire_lock || { echo "认证操作正在进行" >&2; return 75; }
            trap '_release_lock' EXIT
            probe_portal; local r=$?
            case $r in
                0) echo "需要登录"; echo "Host: $P_HOST"; echo "bras: $P_BRAS"
                   echo "clientip: $P_CLIENTIP"; echo "mac: $P_CLIENTMAC"
                   echo "vlan: $P_VLAN"; echo "URL: $P_PORTAL_URL" ;;
                1) echo "已在线" ;;
                2) echo "WAN 未连接或无法探测" ;;
                3) echo "探测未确认，保留会话，稍后复查" ;;
                4) echo "WAN 已有地址，等待出口路由" ;;
            esac
            ;;
        status)
            [ -f "$STATUS_FILE" ] || { echo "未运行"; exit 1; }
            cat "$STATUS_FILE"
            [ -f "$PID_FILE" ] && {
                local pid; pid=$(cat "$PID_FILE")
                _daemon_running \
                    && echo "Daemon: 运行中 PID=$pid" \
                    || echo "Daemon: 未运行（残留 PID 文件）"
            }
            ;;
        logs)
            _range "${1:-50}" 1 5000 || return 64
            [ -f "$LOG_FILE" ] && tail -n "${1:-50}" "$LOG_FILE" || echo "(无日志)"
            ;;
        logs-clear) > "$LOG_FILE"; echo "已清空" ;;
        test-encrypt)
            local r; r=$(encrypt_pass "${CFG_PASS:-testpass}" "$CFG_KEY")
            [ -n "$r" ] && echo "OK: ${r:0:16}... ($(( ${#r}/2 )) bytes)" || { echo "FAIL"; exit 1; }
            ;;
        stop)
            if [ -x /etc/init.d/portal-login ]; then
                /etc/init.d/portal-login stop
            else
                _daemon_running && kill "$(cat "$PID_FILE")" 2>/dev/null
            fi
            echo "已发送停止请求"
            ;;
        help|--help|-h) usage ;;
        *) echo "未知命令: $cmd"; usage; exit 1 ;;
    esac
}

main "$@"
